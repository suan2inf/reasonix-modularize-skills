<mxfile host="app.diagrams.net" modified="2026-05-26T00:00:00.000Z" agent="opencode" version="24.0.0">
  <diagram name="Modularize Architecture" id="modularize-arch">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;Modularize Skill — 架构总览&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== PURPOSE BOX ==================== -->
        <mxCell id="purpose-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="520" height="220" as="geometry" />
        </mxCell>
        <mxCell id="purpose-title" value="&lt;b&gt;🎯 设计目的&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="60" y="85" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="purpose-1" value="&lt;b&gt;问题&lt;/b&gt;：Reasonix 的 Append-Only 会话逻辑 + 前缀缓存虽然省费用，但超长会话导致上下文膨胀、生成变慢、注意力稀释" style="text;html=1;strokeColor=none;fillColor=#F44336;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="purpose-2" value="&lt;b&gt;方案&lt;/b&gt;：任务开始前就把大任务拆成独立功能模块，每个模块开独立 Session，通过共享的字节稳定前缀（prefix.md）让缓存命中率不降" style="text;html=1;strokeColor=none;fillColor=#4CAF50;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="purpose-3" value="&lt;b&gt;产出&lt;/b&gt;：每个模块契约清晰、Session 上下文短小、缓存持续命中、输出可独立验证。比「一直开着」更省钱更快更稳定" style="text;html=1;strokeColor=none;fillColor=#2196F3;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="purpose-4" value="&lt;b&gt;运行载体&lt;/b&gt;：利用 Reasonix 原生 Skill 系统（runAs: subagent）/ Memory（跨模块知识）/ Hooks（生命周期）" style="text;html=1;strokeColor=none;fillColor=#9C27B0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="225" width="480" height="28" as="geometry" />
        </mxCell>

        <!-- ==================== COMPARISON BOX ==================== -->
        <mxCell id="compare-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="80" width="520" height="220" as="geometry" />
        </mxCell>
        <mxCell id="compare-title" value="&lt;b&gt;⚡ 传统 vs Modularize&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="610" y="85" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="compare-traditional" value="&lt;b&gt;传统做法（一直开着）&lt;/b&gt;&lt;br&gt;┌── A ──┐&lt;br&gt;├── B ──┤  ← 线性增长&lt;br&gt;├── C ──┤  ← 上下文膨胀&lt;br&gt;├── D ──┤  ← 缓存后期失效&lt;br&gt;└── E ──┘  ← 注意力稀释&lt;br&gt;Token 从 1K → 50K，越跑越贵越慢" style="text;html=1;strokeColor=#F44336;fillColor=#FFEBEE;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="compare-modular" value="&lt;b&gt;Modularize 做法&lt;/b&gt;&lt;br&gt;[prefix.md] = SYSTEM（不变）&lt;br&gt;  ├─ Subagent A: SYSTEM + 模块A契约(USER)&lt;br&gt;  │   ↓ SYSTEM 缓存命中 ✓&lt;br&gt;  ├─ Subagent B: SYSTEM + 模块B契约(USER)&lt;br&gt;  │   ↓ SYSTEM 缓存命中 ✓&lt;br&gt;  ├─ Subagent C: SYSTEM + 模块C契约(USER)&lt;br&gt;  │   ↓ SYSTEM 缓存命中 ✓&lt;br&gt;每个 Subagent 隔离上下文、快速、稳定" style="text;html=1;strokeColor=#4CAF50;fillColor=#E8F5E9;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="120" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- Arrow from purpose to comparison -->
        <mxCell id="arrow-purpose-compare" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;entryX=0;entryY=0.5;exitX=1;exitY=0.5;" edge="1" parent="1" source="purpose-group" target="compare-group">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== PHASES FLOW ==================== -->
        <mxCell id="flow-title" value="&lt;b style=&quot;font-size:18px&quot;&gt;📋 五阶段工作流&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="450" y="330" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- Phase 1 -->
        <mxCell id="p1-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1-header" value="Phase 1: 分析拆分" style="text;html=1;strokeColor=none;fillColor=#3949AB;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-content" value="&lt;b&gt;命令&lt;/b&gt;: /decompose&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;: 任务描述&lt;br&gt;&lt;b&gt;过程&lt;/b&gt;: AI分析→画依赖图→用户确认调整&lt;br&gt;&lt;b&gt;产出&lt;/b&gt;: plan.json (模块依赖图)&lt;br&gt;&lt;b&gt;支持递归&lt;/b&gt;: 模块过大可子拆分" style="text;html=1;strokeColor=none;fillColor=#E8EAF6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="425" width="240" height="105" as="geometry" />
        </mxCell>

        <!-- Arrow 1→2 -->
        <mxCell id="arrow-1-2" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;entryX=0;entryY=0.5;exitX=1;exitY=0.5;" edge="1" parent="1" source="p1-box" target="p2-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="300" y="460" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Phase 2 -->
        <mxCell id="p2-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2-header" value="Phase 2: 契约定义" style="text;html=1;strokeColor=none;fillColor=#2E7D32;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="330" y="390" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-content" value="&lt;b&gt;命令&lt;/b&gt;: /contracts&lt;br&gt;&lt;b&gt;过程&lt;/b&gt;: AI生成每个模块的&lt;br&gt;  ① TypeScript类型签名&lt;br&gt;  ② 行为描述（人类可读）&lt;br&gt;  ③ 输入/输出/错误语义&lt;br&gt;&lt;b&gt;产出&lt;/b&gt;: contracts/*.md + prefix.md&lt;br&gt;  （契约放 USER，前缀放 SYSTEM）" style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="425" width="240" height="105" as="geometry" />
        </mxCell>

        <!-- Arrow 2→3 -->
        <mxCell id="arrow-2-3" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p2-box" target="p3-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Phase 3 -->
        <mxCell id="p3-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3-header" value="Phase 3: 拓扑调度" style="text;html=1;strokeColor=none;fillColor=#F57F17;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="610" y="390" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-content" value="&lt;b&gt;命令&lt;/b&gt;: /schedule&lt;br&gt;&lt;b&gt;过程&lt;/b&gt;: 解析依赖图 → 计算入度&lt;br&gt;  → 拓扑排序 → 分波次&lt;br&gt;&lt;b&gt;产出&lt;/b&gt;: plan.json 补充 waves&lt;br&gt;&lt;br&gt;Wave 0 (并行): [db, storage]&lt;br&gt;Wave 1 (等待): [auth]&lt;br&gt;Wave 2 (等待): [api]&lt;br&gt;Wave 3 (等待): [frontend]" style="text;html=1;strokeColor=none;fillColor=#FFF8E1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="425" width="240" height="105" as="geometry" />
        </mxCell>

        <!-- Arrow 3→4 -->
        <mxCell id="arrow-3-4" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p3-box" target="p4-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Phase 4 -->
        <mxCell id="p4-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="380" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-header" value="Phase 4: Subagent 执行 ⚡核心" style="text;html=1;strokeColor=none;fillColor=#6A1B9A;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="890" y="390" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-content" value="&lt;b&gt;命令&lt;/b&gt;: /execute &lt;module&gt;&lt;br&gt;&lt;b&gt;每个模块 = 一个 Subagent Skill:&lt;/b&gt;&lt;br&gt;  SYSTEM: prefix.md（项目概述，不变）&lt;br&gt;  USER: contract.md（模块契约）&lt;br&gt;  USER: 上游 result.md（产出摘要）&lt;br&gt;&lt;b&gt;产出&lt;/b&gt;: outputs/{模块}/result.md&lt;br&gt;&lt;b&gt;关键&lt;/b&gt;: SYSTEM 不变 → 跨 subagent 缓存命中！&lt;br&gt;  runAs: subagent → 隔离上下文" style="text;html=1;strokeColor=none;fillColor=#E1BEE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="890" y="425" width="240" height="105" as="geometry" />
        </mxCell>

        <!-- Arrow 4→5 (curved down and back) -->
        <mxCell id="arrow-4-5" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p4-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1010" y="620" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1100" y="460" />
              <mxPoint x="1100" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Phase 5 -->
        <mxCell id="p5-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#BF360C;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="590" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-header" value="Phase 5: 集成验证" style="text;html=1;strokeColor=none;fillColor=#BF360C;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="890" y="600" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5-content" value="&lt;b&gt;命令&lt;/b&gt;: /integrate&lt;br&gt;&lt;b&gt;过程&lt;/b&gt;:&lt;br&gt;  ① result.md ↔ 原契约 一致性比对&lt;br&gt;  ② 上下游接口签名匹配检查&lt;br&gt;  ③ 运行集成测试（可选）&lt;br&gt;&lt;b&gt;失败&lt;/b&gt;: 标记故障模块 → 只重跑该模块+下游&lt;br&gt;&lt;b&gt;通过&lt;/b&gt;: → DONE ✓" style="text;html=1;strokeColor=none;fillColor=#FFE0B2;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="890" y="635" width="240" height="105" as="geometry" />
        </mxCell>

        <!-- Failure loop back -->
        <mxCell id="arrow-fail-back" value="&lt;b&gt;仅重跑失败模块+下游&lt;/b&gt;" style="endArrow=classic;html=1;strokeColor=#F44336;strokeWidth=2;dashed=1;fontColor=#F44336;fontSize=11;" edge="1" parent="1" source="p5-box" target="p4-box">
          <mxGeometry x="-0.2" y="-20" width="50" height="50" relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="800" y="670" />
              <mxPoint x="800" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== STATE MACHINE ==================== -->
        <mxCell id="state-title" value="&lt;b style=&quot;font-size:18px&quot;&gt;🔄 状态机&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="100" y="570" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- State boxes -->
        <mxCell id="state-idle" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;等待命令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-idle-analyzed" value="/decompose" style="endArrow=classic;html=1;strokeColor=#1976D2;strokeWidth=2;" edge="1" parent="1" source="state-idle" target="state-analyzed">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-analyzed" value="&lt;b&gt;ANALYZED&lt;/b&gt;&lt;br&gt;模块图已生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="610" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-analyzed-contracted" value="/contracts" style="endArrow=classic;html=1;strokeColor=#388E3C;strokeWidth=2;" edge="1" parent="1" source="state-analyzed" target="state-contracted">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-contracted" value="&lt;b&gt;CONTRACTED&lt;/b&gt;&lt;br&gt;契约+前缀已就绪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="610" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-contracted-ready" value="/schedule" style="endArrow=classic;html=1;strokeColor=#F9A825;strokeWidth=2;" edge="1" parent="1" source="state-contracted" target="state-ready">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-ready" value="&lt;b&gt;READY&lt;/b&gt;&lt;br&gt;等待执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E64A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="610" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-ready-exec" value="/execute-all" style="endArrow=classic;html=1;strokeColor=#E64A19;strokeWidth=2;" edge="1" parent="1" source="state-ready" target="state-progress">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-progress" value="&lt;b&gt;IN_PROGRESS&lt;/b&gt;&lt;br&gt;逐波执行中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="610" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-progress-done" value="全部完成" style="endArrow=classic;html=1;strokeColor=#4CAF50;strokeWidth=2;" edge="1" parent="1" source="state-progress" target="state-done">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="700" />
              <mxPoint x="820" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-done" value="&lt;b&gt;DONE&lt;/b&gt;&lt;br&gt;✓ 集成通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#43A047;fontSize=12;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="760" y="690" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-progress-fail" value="部分失败" style="endArrow=classic;html=1;strokeColor=#F44336;strokeWidth=2;dashed=1;" edge="1" parent="1" source="state-progress" target="state-failed">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="630" />
              <mxPoint x="720" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-failed" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;某模块未通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#E53935;fontSize=12;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="780" y="610" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow-fail-retry" value="仅重跑失败模块+下游" style="endArrow=classic;flush;html=1;strokeColor=#FF9800;strokeWidth=2;dashed=1;fontColor=#FF9800;fontSize=10;" edge="1" parent="1" source="state-failed" target="state-progress">
          <mxGeometry x="0.2" y="20" width="50" height="50" relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="840" y="585" />
              <mxPoint x="720" y="585" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== CACHE MECHANISM ==================== -->
        <mxCell id="cache-title" value="&lt;b style=&quot;font-size:18px&quot;&gt;⚡ 缓存机制详解（核心创新）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="300" y="780" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="cache-explain" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1450" height="170" as="geometry" />
        </mxCell>

        <!-- Session A -->
        <mxCell id="cache-session-a" value="&lt;b&gt;Subagent A (database 模块)&lt;/b&gt;&lt;br&gt;&lt;br&gt;┌─────────────────────┐&lt;br&gt;│ SYSTEM:              │&lt;br&gt;│  prefix.md ← 缓存基础│&lt;br&gt;│  (项目概述+规范)      │&lt;br&gt;├─────────────────────┤&lt;br&gt;│ USER:                │&lt;br&gt;│  contracts/db.md     │&lt;br&gt;│  "实现 database 模块" │&lt;br&gt;└─────────────────────┘&lt;br&gt;↓ DeepSeek 计算 KV Cache&lt;br&gt;SYSTEM 部分缓存到服务端" style="text;html=1;strokeColor=#7B1FA2;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="835" width="200" height="145" as="geometry" />
        </mxCell>

        <mxCell id="cache-arrow-a-b" value="" style="endArrow=classic;html=1;strokeColor=#4CAF50;strokeWidth=2;" edge="1" parent="1" source="cache-session-a" target="cache-session-b">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Session B -->
        <mxCell id="cache-session-b" value="&lt;b&gt;Subagent B (auth 模块)&lt;/b&gt;&lt;br&gt;&lt;br&gt;┌─────────────────────┐&lt;br&gt;│ SYSTEM:              │&lt;br&gt;│  prefix.md ← 一模一样！│&lt;br&gt;│  (项目概述+规范)      │&lt;br&gt;├─────────────────────┤&lt;br&gt;│ USER:                │&lt;br&gt;│  contracts/auth.md   │&lt;br&gt;│  outputs/db/result.md │&lt;br&gt;│  "实现 auth 模块"     │&lt;br&gt;└─────────────────────┘&lt;br&gt;✓ SYSTEM prefix 字节相同&lt;br&gt;→ SYSTEM KV 缓存命中！&lt;br&gt;USER 部分单独计算" style="text;html=1;strokeColor=#4CAF50;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="835" width="220" height="145" as="geometry" />
        </mxCell>

        <mxCell id="cache-arrow-b-c" value="" style="endArrow=classic;html=1;strokeColor=#4CAF50;strokeWidth=2;" edge="1" parent="1" source="cache-session-b" target="cache-session-c">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Session C -->
        <mxCell id="cache-session-c" value="&lt;b&gt;Subagent C (frontend 重跑)&lt;/b&gt;&lt;br&gt;&lt;br&gt;┌─────────────────────┐&lt;br&gt;│ SYSTEM:              │&lt;br&gt;│  prefix.md ← 仍一样！ │&lt;br&gt;│  (项目概述+规范)      │&lt;br&gt;├─────────────────────┤&lt;br&gt;│ USER:                │&lt;br&gt;│  contracts/fe.md     │&lt;br&gt;│  outputs/api/result.md│&lt;br&gt;│  "重写 frontend 模块" │&lt;br&gt;└─────────────────────┘&lt;br&gt;✓ SYSTEM prefix 始终不变&lt;br&gt;→ 即使重跑，SYSTEM 缓存依然命中&lt;br&gt;契约修正只影响 USER 部分" style="text;html=1;strokeColor=#2196F3;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="835" width="230" height="145" as="geometry" />
        </mxCell>

        <!-- Key insight -->
        <mxCell id="cache-insight" value="&lt;b&gt;🔑 关键设计&lt;/b&gt;&lt;br&gt;&lt;br&gt;prefix.md = SYSTEM prompt&lt;br&gt;只含项目概述+规范&lt;br&gt;不含任何模块契约&lt;br&gt;&lt;br&gt;contract.md = USER message&lt;br&gt;模块契约放这里&lt;br&gt;&lt;br&gt;SYSTEM 字节不变&lt;br&gt;→ KV Cache 跨 subagent 命中&lt;br&gt;USER 每模块不同&lt;br&gt;→ 不影响缓存" style="text;html=1;strokeColor=#FF5722;fillColor=#FFF3E0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="835" width="220" height="145" as="geometry" />
        </mxCell>

        <mxCell id="cache-cost" value="&lt;b&gt;💰 成本对比&lt;/b&gt;&lt;br&gt;&lt;br&gt;一直开着: 4亿 token ~ $12&lt;br&gt;Modularize: 每个模块 ~ $2&lt;br&gt;4模块 x $2 = $8&lt;br&gt;省 33%+&lt;br&gt;越大的任务越省" style="text;html=1;strokeColor=#43A047;fillColor=#E8F5E9;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;spacing=8;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="1050" y="835" width="200" height="145" as="geometry" />
        </mxCell>

        <!-- ==================== FILE STRUCTURE ==================== -->
        <mxCell id="files-title" value="&lt;b style=&quot;font-size:18px&quot;&gt;📁 文件结构（嵌入 Reasonix agent 体系）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="300" y="1020" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="file-structure" value="&lt;b&gt;.reasonix/agents/modularize/&lt;/b&gt;&lt;br&gt;├── &lt;b style=&quot;color:#1565C0&quot;&gt;SKILL.md&lt;/b&gt;                   入口 + 路由表&lt;br&gt;├── &lt;b style=&quot;color:#1565C0&quot;&gt;phases/&lt;/b&gt;                     按需加载的阶段指令&lt;br&gt;│   ├── 01-analyze.md          任务分析→拆分模块&lt;br&gt;│   ├── 02-contracts.md        接口契约+前缀生成&lt;br&gt;│   ├── 03-schedule.md         依赖图+波次调度&lt;br&gt;│   ├── 04-execute.md          逐模块执行⚡核心&lt;br&gt;│   └── 05-integrate.md        集成验证+失败处理&lt;br&gt;├── &lt;b style=&quot;color:#1565C0&quot;&gt;templates/&lt;/b&gt;                 产出模板&lt;br&gt;│   ├── contract.template.md   模块契约模板&lt;br&gt;│   ├── prefix.template.md     共享前缀模板&lt;br&gt;│   └── result.template.md     模块产出摘要模板&lt;br&gt;├── &lt;b style=&quot;color:#1565C0&quot;&gt;reference/&lt;/b&gt;                参考文档&lt;br&gt;│   ├── dependency-graph.md    DAG算法&lt;br&gt;│   └── contract-format.md     契约格式规范&lt;br&gt;└── &lt;b style=&quot;color:#1565C0&quot;&gt;examples/&lt;/b&gt;                  示例&lt;br&gt;    └── blog-system.md         博客系统完整示例&lt;br&gt;&lt;br&gt;&lt;b&gt;任务运行时产出（.reasonix/modules/）&lt;/b&gt;&lt;br&gt;├── plan.json                    依赖图+波次+状态&lt;br&gt;├── &lt;b style=&quot;color:#2E7D32&quot;&gt;prefix.md&lt;/b&gt;                    共享前缀 ⚡缓存关键&lt;br&gt;├── &lt;b style=&quot;color:#F57F17&quot;&gt;contracts/&lt;/b&gt;                   接口契约&lt;br&gt;│   ├── database.md&lt;br&gt;│   ├── auth.md&lt;br&gt;│   └── api.md&lt;br&gt;└── &lt;b style=&quot;color:#6A1B9A&quot;&gt;outputs/&lt;/b&gt;                     模块产出&lt;br&gt;    ├── database/&lt;br&gt;    │   └── result.md&lt;br&gt;    └── auth/&lt;br&gt;        └── result.md" style="text;html=1;strokeColor=#455A64;fillColor=#ECEFF1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;spacing=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="1060" width="1480" height="340" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
